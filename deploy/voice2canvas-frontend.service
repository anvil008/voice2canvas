[Unit]
Description=voice2canvas voice dashboard frontend (vite dev server, LAN)
After=network-online.target voice2canvas-backend.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/repos/voice2canvas/frontend
ExecStart=/usr/bin/env npm run dev -- --host 0.0.0.0 --port 5173
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
