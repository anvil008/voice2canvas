[Unit]
Description=V2UI CT100 loopback edge relay socket
Documentation=https://www.freedesktop.org/software/systemd/man/257/systemd.socket.html

[Socket]
# Tailscale Serve must continue to target this local-only listener. Do not bind
# any non-loopback address and do not change existing HTTPS handlers here.
ListenStream=127.0.0.1:18083
Accept=no
Backlog=64
MaxConnections=64
NoDelay=true
Service=v2ui-edge-proxy.service

[Install]
WantedBy=sockets.target
