# Voice2Canvas environment configuration template.
# Copy to /etc/voice2canvas/voice2canvas.env or .env.

PORT=8080
VOICE2CANVAS_LISTEN_ADDR=0.0.0.0:8080
VOICE2CANVAS_STATIC_DIR=/opt/voice2canvas/static

# Gemini API configuration.
GEMINI_API_KEY=
VOICE2CANVAS_LIVE_MODEL=gemini-3.1-flash-live-preview
VOICE2CANVAS_CARD_MODEL=gemini-3.6-flash

# Optional Google Cloud / Vertex AI settings.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# Logging configuration.
LOG_FORMAT=json
LOG_LEVEL=info
