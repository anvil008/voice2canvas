# Voice2Canvas production environment template. Install as /etc/v2ui/v2ui.env with
# owner root:v2ui and mode 0640. Secret values are deliberately blank.

# Production runtime contract.
PORT=8083
VOICE2CANVAS_LISTEN_ADDR=0.0.0.0:8083
V2UI_LISTEN_ADDR=0.0.0.0:8083

# Gemini authentication.
GEMINI_API_KEY=
VOICE2CANVAS_LIVE_MODEL=gemini-3.1-flash-live-preview
V2UI_LIVE_MODEL=gemini-3.1-flash-live-preview
VOICE2CANVAS_CARD_MODEL=gemini-3.6-flash
V2UI_CARD_MODEL=gemini-3.6-flash

# Optional Vertex AI / ADC credentials.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_APPLICATION_CREDENTIALS=

# Optional telemetry and integrations.
V2UI_LOKI_URL=http://10.0.20.230:3100
V2UI_PROM_URL=http://10.0.20.230:9090
V2UI_PVE_URL=https://10.0.20.10:8006
V2UI_PVE_TOKEN_ID=
V2UI_PVE_TOKEN_SECRET=
V2UI_PVE_INSECURE_TLS=false

# Optional coding terminals configuration.
V2UI_CONTROL_TOKEN=
V2UI_CODE_ROOTS=
V2UI_ALLOWED_ORIGINS=
