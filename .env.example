# Optional: the browser can provide a per-session key instead.
GEMINI_API_KEY=

# Optional Vertex AI / ADC alternative.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# Model overrides.
VOICE2CANVAS_LIVE_MODEL=gemini-3.1-flash-live-preview
V2UI_LIVE_MODEL=gemini-3.1-flash-live-preview
VOICE2CANVAS_CARD_MODEL=gemini-3.6-flash
V2UI_CARD_MODEL=gemini-3.6-flash

# Server listen and dev proxy settings.
# Backend listen address (e.g. :8080, 0.0.0.0:8080). Takes precedence over PORT.
VOICE2CANVAS_LISTEN_ADDR=
V2UI_LISTEN_ADDR=
# Backend server port (e.g. 8080). Used when VOICE2CANVAS_LISTEN_ADDR / V2UI_LISTEN_ADDR is unset. Also used as the default Vite proxy port.
PORT=
# Vite dev server backend proxy target port (defaults to PORT or 8080).
VOICE2CANVAS_BACKEND_PORT=
V2UI_BACKEND_PORT=
